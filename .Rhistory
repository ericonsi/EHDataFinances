library(EHDataFinances)
library(knitr)
xCategory="Shopping"
dfExSum <- EHFinances_FilterByCategory(dfExpensesReviewed, "Shopping")
a <- paste0("Total shopping from bank info: ", sum(dfExSum$Amount))
b <- paste0("Total shopping from Amazon: ", sum(dfShopping$Amount))
a
b
z <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfShopping |> dplyr::select(SubCategory, Amount), xfill =EH_Squash, rectfill = EH_Cream, font_size = 9, xtitle = xCategory)
q <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfShopping_YTD |> dplyr::select(SubCategory, Amount), xfill =EH_Squash, rectfill = EH_Cream, font_size = 9, xtitle = xCategory)
grid.arrange(z,q,ncol=2)
EHFinances_CreateTopSpendingTable(dfShopping, xCategory, Folder, fontSize=8)
EHFinances_CreateTopSpendingTable(dfShopping_YTD, xCategory = xCategory, Folder, fontSize=8, ytd=TRUE)
a <- dfShopping |>
group_by(xScale) |>
dplyr::summarize(Count = n(), Expenditures = sum(Amount)) |>
kable(
col.names = c("xScale", "Count", "Expenditures"),
caption = paste0("Count and Amount by Scale, ", Folder),
align = c("l", "r")
) %>%
kable_styling(
bootstrap_options = c("striped", "hover"),
full_width = FALSE,
font_size=8)

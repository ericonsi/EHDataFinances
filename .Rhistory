library(gridGraphics)
library(kableExtra)
library(anytime)
unloadNamespace("EHDataFinances")
devtools::install_github("ericonsi/EHDataFinances")
library(EHDataFinances)
EHFinances_CategoryDetails(dfExpensesReviewed, dfExpensesReviewed_YTD, "Home")
EHFinances_CategoryDetails(dfExpensesReviewed, dfExpensesReviewed_YTD, xCategory ="Home", Folder)

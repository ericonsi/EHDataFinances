dplyr::filter(Core==1) |>
group_by(Category) |>
dplyr::summarise(Estimated = sum(Estimated)) |>
dplyr::select(Category, Estimated) |>
dplyr::arrange(Category)
Total = c("Total", sum(dfExpenses2025Totalsr$Estimated))
dfExpenses2025Totalsr_WithTotal <- rbind(dfExpenses2025Totalsr_WithTotal, Total) |>
mutate(Estimated=as.numeric(Estimated))
kable(dfExpenses2025Totalsr_WithTotal, caption = "Estimated Annual Expenses", format.args = list(big.mark = ","), digits = 0) |>
kable_styling(full_width = FALSE, position = "center",
latex_options = c("striped", "hold_position"))
kable(dfExpenses2025Totalsr |> dplyr::filter(Core==1) |> dplyr::arrange(Category, SubCategory) |>
dplyr::select(Category, SubCategory, Estimated),  caption = "Estimated Annual Expenses Breakdown", format.args = list(big.mark = ","), digits = 0) |>
kable_styling(full_width = FALSE, position = "center",
latex_options = c("striped", "hold_position"))

unloadNamespace("EHDataFinances")
devtools::install_github("ericonsi/EHDataFinances", force=TRUE)
library(EHDataFinances)
#Assign Month
xMonth="2602"
Folder = xMonth
# Import data
dfExpenses <- EHFinances_ImportRawAccountFiles(xMonth)[[1]]
dfCategories <- EHFinances_ImportCategories()
dfAmazonOrders <- EHFinances_ImportAmazonOrders(xMonth)
# Assign Categories and Shocks
dfExpenses2 <- EHFinances_AssignCategoriesAndSubcategories(dfExpenses)
dfExpenses3 <- EHFinances_AssignTrips(dfExpenses2, "2025-12-28", "2026-01-08", "Rio")
dfExpenses3 <- EHFinances_AssignTrips(dfExpenses2, "2026-02-2", "2026-02-10", "Puerto Rico")
dfExpenses4 <- EHFinances_AssignRuby(dfExpenses3)
dfExpenses5 <- EHFinances_AssignAccountsToDelete(dfExpenses4)
dfExpenses6 <- EHFinances_ApplyBusinessRules(dfExpenses5)
#Write or open override file
OverrideFileWritten=TRUE
if(OverrideFileWritten){
dfExpenses7 <- EHFinances_WriteOrOpenOverrideFile(Folder=xMonth)
} else {
EHFinances_WriteOrOpenOverrideFile(dfExpenses6, Folder=xMonth, xType = "Create")
}
# Disaggregate Files - only works after override file has been written
liExpenseDFs <- EHFinances_CreateShockAndExpenseDFs(dfExpenses7)
dfExpensesReviewed = liExpenseDFs[[1]]
dfRuby <- liExpenseDFs[[2]]
dfRenovation <- liExpenseDFs[[3]]
dfIncomeTaxes <- liExpenseDFs[[4]]
#Create df for shopping analysis
vPagesx = c(paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details1.html"), paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details2.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details3.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details4.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details5.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details6.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details7.html"),
paste0("D:\\RStudio\\Finances\\AccountDownloads\\", xMonth, "\\Details8.html"))
dfShopping <- EHFinances_CreateDfForShoppingAnalysis(dfExpensesReviewed, vPages = vPagesx, xMonth)
mat2 <- matrix(c(sum(dfExpensesReviewed$Amount), sum((dfRuby |> filter(SubCategory == "Tuition Etc."))$Amount), sum((dfRuby |> filter(SubCategory != "Tuition Etc."))$Amount), sum(dfRenovation$Amount),  sum(dfIncomeTaxes$Amount)), ncol=1, byrow=FALSE)
colnames(mat2) <- c("Amount")
rownames(mat2) <- c("Total Expenses:", "Total Ruby Tuition:", "Ruby Non Tuition:", "Renovation:", "Income Taxes:")
tab_custom <- kable(as.table(mat2))
tab_custom
EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |> dplyr::select(Category, Amount), xfill ="turquoise", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Total Spent by Category")
a <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Health & Wellness") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Health & Wellness")
b <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Home") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Home")
c <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Travel") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Travel")
d <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Groceries") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Groceries")
e <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Travel Local") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Travel Local")
f <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfShopping |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Shopping")
g <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Food & Drink") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Food & Drink")

unloadNamespace("EHDataFinances")
devtools::install_github("ericonsi/EHDataFinances", force=TRUE)
library(EHDataFinances)
#Assign Month
xMonth="2602"
Folder = xMonth
# Import data
dfExpenses <- EHFinances_ImportRawAccountFiles(xMonth)[[1]]
dfCategories <- EHFinances_ImportCategories()
dfAmazonOrders <- EHFinances_ImportAmazonOrders(xMonth)
# Assign Categories and Shocks
dfExpenses2 <- EHFinances_AssignCategoriesAndSubcategories(dfExpenses)
dfExpenses3 <- EHFinances_AssignTrips(dfExpenses2, "2025-12-28", "2026-01-08", "Rio")
dfExpenses3 <- EHFinances_AssignTrips(dfExpenses2, "2026-02-2", "2026-02-10", "Puerto Rico")
dfExpenses4 <- EHFinances_AssignRuby(dfExpenses3)
dfExpenses5 <- EHFinances_AssignAccountsToDelete(dfExpenses4)
dfExpenses6 <- EHFinances_ApplyBusinessRules(dfExpenses5)
dfExpenses7 <- EHFinances_AssignFoodSubCategories(dfExpenses6)
dfExpenses8 <- EHFinances_AssignShoppingCategories(dfExpenses7)
#Write or open override file
dfExpenses9 <- EHFinances_WriteOrOpenOverrideFile(dfExpenses8, Folder=xMonth, AlreadyWritten = TRUE)
# Disaggregate Files - only works after override file has been written
liExpenseDFs <- EHFinances_CreateShockAndExpenseDFs(dfExpenses9)
dfExpensesReviewed = liExpenseDFs[[1]]
dfRuby <- liExpenseDFs[[2]]
dfRenovation <- liExpenseDFs[[3]]
dfIncomeTaxes <- liExpenseDFs[[4]]
#Create df for shopping analysis
dfShopping <- EHFinances_CreateDfForShoppingAnalysis(dfExpensesReviewed, Folder=xMonth)
# Create ytd dfs
liExpenseDFs <- EHFinances_CreateYtdDfs(Folder)
dfExpensesReviewed_YTD = liExpenseDFs[[1]]
dfRuby_YTD <- liExpenseDFs[[2]]
dfRenovation_YTD <- liExpenseDFs[[3]]
dfIncomeTaxes_YTD <- liExpenseDFs[[4]]
#Perform Budget Analysis
liBudget <- EHFinances_CreateBudgetAnalysisDFs(dfExpensesReviewed, dfExpensesReviewed_YTD, Folder)
dfBudget <- liBudget[[1]]
dfBudget_YTD <- liBudget[[2]]
mat2 <- matrix(c(sum(dfExpensesReviewed$Amount), sum((dfRuby |> filter(SubCategory == "Tuition Etc."))$Amount), sum((dfRuby |> filter(SubCategory != "Tuition Etc."))$Amount), sum(dfRenovation$Amount),  sum(dfIncomeTaxes$Amount)), ncol=1, byrow=FALSE)
colnames(mat2) <- c("Amount")
rownames(mat2) <- c("Total Expenses:", "Total Ruby Tuition:", "Ruby Non Tuition:", "Renovation:", "Income Taxes:")
tab_custom <- kable(as.table(mat2))
tab_custom
grid.arrange(liBudget[[3]], liBudget[[4]], ncol = 2)
a <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |> dplyr::select(Category, Amount), xfill ="turquoise", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Total Spent by Category, 2602")
b <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed_YTD |> dplyr::select(Category, Amount), xfill ="turquoise", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Total Spent by Category, YTD")
grid.arrange(a, b, ncol = 2)
a <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Health & Wellness") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Health & Wellness")
b <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Home") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Home")
c <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Travel") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Travel")
d <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Groceries") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Groceries")
e <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Travel Local") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Travel Local")
f <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfShopping |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Shopping")
g <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Food & Drink") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Food & Drink")
grid.arrange(a, b, c, d, e, f, g, ncol=2)
a <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Gifts & Donations") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Gifts & Donations")
b <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Car") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Car")
c <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Entertainment") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Entertainment")
d <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Education") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Education")
e <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfExpensesReviewed |>  dplyr::filter(ToDelete == 0, Category=="Subscriptions") |> dplyr::select(SubCategory, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "SubScriptions")
f <- EHSummarize_CategoryByTotal_ReturnsSingleTable(dfShopping |> dplyr::select(xScale, Amount), xfill ="chocolate1", rectfill = "lemonchiffon1", font_size = 9, xtitle = "Shopping by Scale")
grid.arrange(a, b, c, d, e, f, ncol=2)
dfCat <- dfExpensesReviewed |>
dplyr::filter(SubCategory=="Utilities")
x <- EHFinances_FilterByCategory(dfExpensesReviewed, "Education")
#print(paste("Expenses:", sum(dfExpensesReviewed$Amount)))
#print(paste("Ruby Tuition:", sum((dfRubyShock |> filter(`Sub category`== "Tuition Etc."))$Amount)))
#print(paste("Ruby Non Tuition:", sum((dfRubyShock |> filter(`Sub category`!= "Tuition Etc."))$Amount)))
#print(paste("Renovation:", sum(dfRenovationShock$Amount)))
#print(paste("Income Taxes:", sum(dfIncomeTax$Amount)))
EHFinances_TestIfDataIsInRange <- function(xDate, Folder) {
x <- if_else(year(xDate)==EHFinances_RetrieveYearAndMonth(Folder)[[1]], month(xDate)==EHFinances_RetrieveYearAndMonth(Folder)[[2]], TRUE, FALSE)
return (x)
}
z <- EHFinances_TestIfDataIsInRange("2026-03-01", Folder)
library(dplyr)
library(ggplot2)
df <- dfBudget_YTD |>
dplyr::rename(spent=Amount_Spent, budget=Amount_Budget, category=Category)
df_plot <- df %>%
mutate(
status = ifelse(spent > budget, "Over budget", "Under budget")
) %>%
arrange(spent) %>%
mutate(category = factor(category, levels = category))
ggplot(df_plot, aes(x = category)) +
# Budget (background bar)
geom_col(aes(y = budget),
fill = "grey80",
width = 0.7) +
# Spent (foreground bar)
geom_col(aes(y = spent, fill = status),
width = 0.3) +
ggtitle("Spending vs Budget, Year to Date") +
coord_flip() +
scale_fill_manual(values = c(
"Under budget" = "#33a0a0",
"Over budget" = "#c76030"
)) +
labs(
x = "",
y = "Amount",
fill = ""
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
panel.grid.major.y = element_blank()
)
knitr::opts_chunk$set(echo = FALSE, warning =  FALSE, message = FALSE)

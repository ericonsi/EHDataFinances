geom_line(aes(y = Budget, color = "Budget"), size = 3) +
geom_point(aes(y = Expenditures, color = EH_LabelColor), size = 2) +
theme(panel.background = element_rect(fill = EH_Cream, colour = "black"), panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
scale_color_manual("", values = c("Expenditures" = EH_Turquoise, "Budget" = EH_Squash)) +
scale_x_continuous(breaks = function(x) seq(ceiling(min(x)), floor(max(x)), by = 1)) +
ggtitle("Expenditures Over Time") +
scale_y_continuous(limits = c(0, NA))
return(a)
}
EHFinances_CreateTimePlot(dfExpensesReviewed_YTD, dfBudget, xCategory)
EHFinances_CategoryDetails(dfExpensesReviewed, dfExpensesReviewed_YTD, xCategory=xCategory, dfBudget, Folder)
EHFinances_CreateTopSpendingTable(dfExpensesReviewed_YTD, xCategory = xCategory, Folder, fontSize=8, ytd=TRUE)

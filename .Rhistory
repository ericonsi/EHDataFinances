mutate(`Projected Savings` = .2*Amount) |>
mutate(`Projected Savings` = round(`Projected Savings`, 0)) |>
dplyr::arrange(desc(`Projected Savings`)) |>
dplyr::rename(`Current Budget Target` = Amount)
kable(dfBudget_AnnualTargets_Savings,  caption = "Estimated Savings", format.args = list(big.mark = ","), digits = 0) |>
kable_styling(full_width = FALSE, position = "center",
latex_options = c("striped", "hold_position"))
